# Copiá este archivo a .env.local y completalo. .env.local NO se commitea.

# --- Acceso (cuentas con mail y contraseña) ---
# En producción las cuentas viven en Supabase Auth (usa SUPABASE_URL y SUPABASE_SECRET_KEY, más abajo).
# Sin Supabase, en desarrollo, se usa un proveedor local en la misma base.
# La primera cuenta que se crea es la del organizador. Opcional: limitarla a este mail.
# OWNER_EMAIL=
# Secreto para firmar la cookie de sesión (HMAC-SHA256). Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- IA ---
# Por defecto: Vercel AI Gateway (vercel.com → AI Gateway → API Keys).
AI_GATEWAY_API_KEY=
# Alternativa: OpenAI directo (se usa solo si AI_GATEWAY_API_KEY está vacía).
OPENAI_API_KEY=
# Opcionales: pisan base URL y modelo.
# AI_BASE_URL=https://ai-gateway.vercel.sh/v1
# AI_MODEL=openai/gpt-5.4-mini
# real (por defecto) | fake: analizador de prueba sin IA, solo para recorrer la UI.
AI_MODE=real

# --- Pagos ---
# simulated (por defecto) | mainnet. En mainnet se mueven wARS reales en Celo.
PAYMENT_MODE=simulated
# La escribe `npm run wallet:new` (sin imprimirla). No la pegues a mano en ningún chat.
# AGENT_PRIVATE_KEY=

# --- Demo ---
# Tu wallet de colaborador (destino de los reembolsos de la demo).
DEMO_COLLABORATOR_ADDRESS=

# --- Base de datos y comprobantes (Supabase) ---
# Postgres. En Vercel usá el "Transaction pooler" (puerto 6543) de Supabase → Connect.
# Vacía: se usa PGlite (Postgres local en data/pglite), solo para desarrollo.
DATABASE_URL=
# Opcional pero recomendado: CA de Supabase en PEM (Database → Settings → SSL), para verificar el servidor.
# Se puede pegar en una línea con \n en lugar de saltos de línea.
# DATABASE_CA_CERT=
# Storage: el bucket privado de las fotos de los tickets.
SUPABASE_URL=
# Clave secreta (sb_secret_…). Solo servidor. Vacía: los comprobantes van a data/receipts (desarrollo).
SUPABASE_SECRET_KEY=
# SUPABASE_RECEIPTS_BUCKET=tickets

# Carpeta de datos local (PGlite + comprobantes) cuando no hay Supabase. Por defecto ./data
# DATA_DIR=
